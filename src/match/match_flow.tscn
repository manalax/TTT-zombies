allowed_transitions = Array[StringName]([&"Intermission"])

[node name="Victory" type="Node" parent="."]
script = ExtResource("2_state")
allowed_transitions = Array[StringName]([&"Results"])

[node name="Defeat" type="Node" parent="."]
script = ExtResource("2_state")
