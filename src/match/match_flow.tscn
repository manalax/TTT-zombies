[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://src/match/match_flow.gd" id="1_flow"]
[ext_resource type="Script" path="res://src/core/state_machine/state.gd" id="2_state"]

[node name="MatchFlow" type="Node"]
script = ExtResource("1_flow")

[node name="Lobby" type="Node" parent="."]
script = ExtResource("2_state")
